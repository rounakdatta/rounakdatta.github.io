---
// A margin note for MDX: <Sidenote>…</Sidenote> right after the words it explains.
// Same markup as markdown footnotes get (see lib/rehype-sidenotes.mjs), so both look alike,
// and both are numbered by one CSS counter, so notes written either way count in reading order.
import { createHash } from 'node:crypto';

const html = await Astro.slots.render('default');
// Derived from the note itself, so the id is the same on every build.
const key = `sn-${createHash('sha1').update(html).digest('hex').slice(0, 8)}`;
---

<span class="sidenote-anchor"><input type="checkbox" id={key} class="sidenote-toggle" aria-label="Show note" /><label for={key} class="sidenote-number"></label><span class="sidenote" role="note"><span class="sidenote-mark" aria-hidden="true"></span> <Fragment set:html={html} /></span></span>
