---
// Photos as polaroids on a table: a square window cut from each photo, in black and white, a white
// frame with room below for its caption, every one leaning a little its own way. Looked at, a
// polaroid comes up in colour. Pressed, its photo grows out of it to fill the screen, whole and in
// colour; put away, it shrinks back into it, settles, and goes back to black and white.
import PhotoLink from './PhotoLink.astro';
import { altOf, polaroidSizes, polaroidWidths, POLAROID_QUALITY, type Photo } from '../lib/photos';
import { tiltOf } from '../lib/polaroids';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// A caption may be one long word, a file name or a hashtag, wider than a polaroid on a narrow
// phone: it may break after _ . / and before an @ (a handle keeps its @), and between joined-up
// words (Run·For·Thindi), rather than spill off its polaroid and widen the page.
const breakable = (text: string) => text.split(/(?<=[_./])|(?=@)|(?<=[a-z])(?=[A-Z])/);
---

<ul class="wall" data-gallery data-zoom>
  {photos.map((photo, i) => (
    <li class="polaroid" style={`--tilt: ${tiltOf(i)}deg`}>
      {/* Lazy, even the first: the page may open on the prints instead, and then these cost nothing.
          When they are what it opens on, the head asks for the first ones early (photos/index.astro). */}
      <PhotoLink photo={photo} cropped focus={photo.focus} sizes={polaroidSizes(photo)} widths={polaroidWidths(photo)} quality={POLAROID_QUALITY} />
      {/* Read once: with no alt text of its own, the photo already says its caption. */}
      <p class="note" aria-hidden={altOf(photo) === photo.caption ? 'true' : undefined}>{breakable(photo.caption ?? '').map((part, k) => <>{k > 0 && <wbr />}{part}</>)}</p>
    </li>
  ))}
</ul>

<script>
  // A photo still on its way shows the dark of instant film not yet developed, then develops.
  // One already here (cached, or quicker than this script) is simply there.
  for (const img of document.querySelectorAll<HTMLImageElement>('.polaroid img')) {
    if (img.complete) continue;
    img.classList.add('developing');
    const done = () => img.classList.remove('developing');
    img.addEventListener('load', done, { once: true });
    img.addEventListener('error', done, { once: true });
  }
</script>

<style>
  .wall {
    --frame: light-dark(#fff, #e9e5d9);
    /* The frame is pale by day and by night, so its caption has a colour of its own: the site's
       muted ink as it is by day. */
    --caption: #696760;
    --film: #3a352f;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 1.15rem;
    margin: 0;
    /* Room for the corners a lean pushes out, and for a lift on hover. */
    padding: 0.4rem 0 1rem;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.4rem 2.1rem;
    }
  }

  /* The frame. A Polaroid's border is about a twentieth of its width at the sides and top, and
     deep at the bottom where it gets written on. A row's frames share one height: a longer line
     makes the whole row's bottoms deeper, not one card taller than its neighbours. */
  .polaroid {
    position: relative;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    margin: 0;
    padding: 5.5% 5.5% 0;
    border-radius: 2px;
    background: var(--frame);
    box-shadow:
      0 1px 2px light-dark(rgb(60 48 24 / 0.1), rgb(0 0 0 / 0.5)),
      0 10px 24px -12px light-dark(rgb(60 48 24 / 0.38), rgb(0 0 0 / 0.85));
    rotate: var(--tilt);
    transition:
      rotate 0.5s var(--ease-out),
      translate 0.5s var(--ease-out),
      scale 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  /* The whole polaroid is the link, frame and caption included: the link's own area is stretched
     over it, so a press anywhere on the card opens the photo. */
  /* The window shows the dark of instant film until its photo arrives. It is the link's colour,
     not the photo's: a photo still on its way is see-through, and its own background with it. */
  .polaroid :global(.photo-link) {
    display: block;
    background: var(--film);
    cursor: zoom-in;
  }

  .polaroid :global(.photo-link)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .polaroid :global(.photo-link:focus-visible) {
    outline: none;
  }

  .polaroid :global(.photo-link:focus-visible)::after {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 3px;
  }

  /* Black and white until looked at (after shraddha-kulkarni.com/photos). */
  .polaroid :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      opacity 0.6s ease-out,
      filter 0.6s ease;
  }

  /* In colour while a pointer rests on it, while it has the keyboard's focus, and while its photo is
     open full-screen, so the photo shrinks back into the same colours. */
  .polaroid:has(:global(.photo-link:focus-visible)) :global(img),
  .polaroid:global(.held) :global(img) {
    filter: none;
  }

  /* Undeveloped at once (there is nothing to fade out yet), developing slowly once it arrives. */
  .polaroid :global(img.developing) {
    opacity: 0;
    transition: none;
  }

  .note {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 19cqi;
    margin: 0;
    padding: 0.3em 0.4em 0.5em;
    /* Set like a label on the print, in the site's own monospace, small and quiet, in the case the
       caption was written in: the captions read like file names and handles (winning_hackathons.jpg,
       @NextTechLab), and Garamond's swashy italic made them look like a storybook. */
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 5.4cqi, 0.82rem);
    font-variant-numeric: normal;
    letter-spacing: 0.01em;
    line-height: 1.45;
    color: var(--caption);
    text-align: center;
    text-wrap: balance;
    /* Anything else too long for the polaroid breaks where it must. */
    overflow-wrap: anywhere;
  }

  /* Looked at with a mouse, a polaroid straightens and comes up off the table. */
  @media (hover: hover) and (pointer: fine) {
    .polaroid:hover {
      z-index: 1;
      rotate: 0deg;
      translate: 0 -6px;
      scale: 1.035;
      box-shadow:
        0 2px 4px light-dark(rgb(60 48 24 / 0.1), rgb(0 0 0 / 0.5)),
        0 22px 36px -16px light-dark(rgb(60 48 24 / 0.42), rgb(0 0 0 / 0.9));
    }

    .polaroid:hover :global(img) {
      filter: none;
    }
  }

  /* Pressed, it gives a little under the finger. */
  .polaroid:active {
    scale: 0.985;
  }

  /* While its photo is open full-screen it lies straight, so the photo shrinks back exactly into
     it; once put away it settles back to its own lean. */
  .polaroid:global(.held) {
    rotate: 0deg;
    translate: 0;
    scale: 1;
  }
</style>
