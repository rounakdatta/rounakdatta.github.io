---
// Photos as polaroids on a table: a square window cut from each photo, in black and white, a white
// frame with room below for its caption, every one leaning a little its own way. Looked at, a
// polaroid straightens and comes up off the table in colour. That is all: it opens nothing bigger.
import { Image } from 'astro:assets';
import { altOf, polaroidSizes, polaroidWidths, POLAROID_QUALITY, type Photo } from '../lib/photos';
import { tiltOf } from '../lib/polaroids';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// A caption may be one long word, a file name or a hashtag, wider than a polaroid on a narrow
// phone: it may break after _ . / and before an @ (a handle keeps its @), and between joined-up
// words (Run·For·Thindi), rather than spill off its polaroid and widen the page.
const breakable = (text: string) => text.split(/(?<=[_./])|(?=@)|(?<=[a-z])(?=[A-Z])/);
---

<ul class="wall">
  {photos.map((photo, i) => (
    <li class="polaroid" style={`--tilt: ${tiltOf(i)}deg`}>
      {/* Lazy, even the first: the page may open on the prints instead, and then these cost nothing.
          When they are what it opens on, the head asks for the first ones early (photos/index.astro).
          A photo, not a link to a bigger one; focusable, so the keyboard can bring it up too. */}
      <div class="window">
        <Image
          src={photo.src}
          alt={altOf(photo)}
          widths={polaroidWidths(photo)}
          sizes={polaroidSizes(photo)}
          format="avif"
          quality={POLAROID_QUALITY}
          loading="lazy"
          layout="none"
          tabindex="0"
          style={photo.focus ? `object-position: ${photo.focus}` : undefined}
        />
      </div>
      {/* Read once: with no alt text of its own, the photo already says its caption. */}
      <p class="note" aria-hidden={altOf(photo) === photo.caption ? 'true' : undefined}>{breakable(photo.caption ?? '').map((part, k) => <>{k > 0 && <wbr />}{part}</>)}</p>
    </li>
  ))}
</ul>

<script>
  // A photo still on its way shows the dark of instant film not yet developed, then develops.
  // One already here (cached, or quicker than this script) is simply there.
  for (const img of document.querySelectorAll<HTMLImageElement>('.polaroid img')) {
    if (img.complete) continue;
    img.classList.add('developing');
    const done = () => img.classList.remove('developing');
    img.addEventListener('load', done, { once: true });
    img.addEventListener('error', done, { once: true });
  }

  // A phone has no pointer to rest on a polaroid, so a tap brings it up instead, just as a mouse
  // resting on it does: one at a time, until it is tapped again, or anything else is, or Escape is
  // pressed. With a mouse a click adds nothing; resting on it has already done it all.
  const mouse = matchMedia('(hover: hover) and (pointer: fine)');
  let up: Element | undefined;
  /** Bring a polaroid up, putting back any other; the one already up goes back. None: put back. */
  const pickUp = (card?: Element) => {
    up?.classList.remove('up');
    up = card === up ? undefined : card;
    up?.classList.add('up');
  };
  for (const wall of document.querySelectorAll<HTMLElement>('.wall')) {
    // Heard on the wall, not the page: Safari on an iPhone sends a tap's click only to something
    // listening for it below the page's body. A tap between two polaroids puts back the one up.
    wall.addEventListener('click', (event) => mouse.matches || pickUp((event.target as Element).closest('.polaroid') ?? undefined));
    // Only the keyboard focuses a photo. Focused by a press, it would come up with the next key
    // pressed for anything else (to scroll on, say), as if the keyboard had brought it up. Pressed,
    // it lets go of what had the focus, as pressing anything that can't take it does: else the arrow
    // keys would still go to the choice above, and turn the page to the prints.
    wall.addEventListener('mousedown', (event) => {
      if (event.button || !(event.target as Element).matches('img')) return;
      event.preventDefault();
      (document.activeElement as HTMLElement | null)?.blur();
    });
  }
  // A tap anywhere off the wall is a touch lifted there without having scrolled the page (one that
  // scrolls ends in pointercancel instead): not a click, which an iPhone doesn't send for a tap on
  // nothing in particular.
  document.addEventListener('pointerup', (event) => (event.target as Element).closest?.('.wall') || pickUp());
  document.addEventListener('keydown', (event) => event.key === 'Escape' && pickUp());
</script>

<style>
  .wall {
    --frame: light-dark(#fff, #e9e5d9);
    /* The frame is pale by day and by night, so its caption has a colour of its own: the site's
       muted ink as it is by day. */
    --caption: #696760;
    --film: #3a352f;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 1.15rem;
    margin: 0;
    /* Room for the corners a lean pushes out, and for a lift on hover. */
    padding: 0.4rem 0 1rem;
    list-style: none;
    /* Coming up is answer enough to a tap, without Safari's grey flash over the wall it's heard on. */
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 40rem) {
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.4rem 2.1rem;
    }
  }

  /* The frame. A Polaroid's border is about a twentieth of its width at the sides and top, and
     deep at the bottom where it gets written on. A row's frames share one height: a longer line
     makes the whole row's bottoms deeper, not one card taller than its neighbours. */
  .polaroid {
    position: relative;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    margin: 0;
    padding: 5.5% 5.5% 0;
    border-radius: 2px;
    background: var(--frame);
    box-shadow:
      0 1px 2px light-dark(rgb(60 48 24 / 0.1), rgb(0 0 0 / 0.5)),
      0 10px 24px -12px light-dark(rgb(60 48 24 / 0.38), rgb(0 0 0 / 0.85));
    rotate: var(--tilt);
    transition:
      rotate 0.5s var(--ease-out),
      translate 0.5s var(--ease-out),
      scale 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  /* The window shows the dark of instant film until its photo arrives. It is the window's colour,
     not the photo's: a photo still on its way is see-through, and its own background with it. */
  .window {
    background: var(--film);
  }

  /* The keyboard's focus is drawn round the whole polaroid; the photo keeps its square corners. */
  .polaroid :global(img:focus-visible) {
    outline: none;
    border-radius: 0;
  }

  .polaroid:has(:global(img:focus-visible))::after {
    content: '';
    position: absolute;
    inset: 0;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 3px;
  }

  /* Black and white until looked at (after shraddha-kulkarni.com/photos). */
  .polaroid :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      opacity 0.6s ease-out,
      filter 0.6s ease;
  }

  /* In colour while a pointer rests on it, while it has the keyboard's focus, and while it is up. */
  .polaroid:has(:global(img:focus-visible)) :global(img),
  .polaroid:global(.up) :global(img) {
    filter: none;
  }

  /* Undeveloped at once (there is nothing to fade out yet), developing slowly once it arrives. */
  .polaroid :global(img.developing) {
    opacity: 0;
    transition: none;
  }

  .note {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 19cqi;
    margin: 0;
    padding: 0.3em 0.4em 0.5em;
    /* Set like a label on the print, in the site's own monospace, small and quiet, in the case the
       caption was written in: the captions read like file names and handles (winning_hackathons.jpg,
       @NextTechLab), and Garamond's swashy italic made them look like a storybook. */
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 5.4cqi, 0.82rem);
    font-variant-numeric: normal;
    letter-spacing: 0.01em;
    line-height: 1.45;
    color: var(--caption);
    text-align: center;
    text-wrap: balance;
    /* Anything else too long for the polaroid breaks where it must. */
    overflow-wrap: anywhere;
    /* Part of the print, as it was while the card was a link: no text cursor, nothing to select. */
    cursor: default;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Looked at with a mouse, a polaroid straightens and comes up off the table. */
  @media (hover: hover) and (pointer: fine) {
    .polaroid:hover {
      z-index: 1;
      rotate: 0deg;
      translate: 0 -6px;
      scale: 1.035;
      box-shadow:
        0 2px 4px light-dark(rgb(60 48 24 / 0.1), rgb(0 0 0 / 0.5)),
        0 22px 36px -16px light-dark(rgb(60 48 24 / 0.42), rgb(0 0 0 / 0.9));
    }

    .polaroid:hover :global(img) {
      filter: none;
    }
  }

  /* Tapped, on a screen with no pointer to rest on it, it comes up just the same (the script above).
     Not :hover there: a phone keeps a tapped thing hovered, so a second tap couldn't put it back. */
  .polaroid:global(.up) {
    z-index: 1;
    rotate: 0deg;
    translate: 0 -6px;
    scale: 1.035;
    box-shadow:
      0 2px 4px light-dark(rgb(60 48 24 / 0.1), rgb(0 0 0 / 0.5)),
      0 22px 36px -16px light-dark(rgb(60 48 24 / 0.42), rgb(0 0 0 / 0.9));
  }
</style>
