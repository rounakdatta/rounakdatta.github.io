---
// Every day since the journal began: the years laid end to end in one strip that drifts sideways,
// annotated in pencil, as it always was. A note's arrow comes in straight along its week's column
// and every day it names is ringed, so no note can be read as the week beside it. Each shade is a
// single path, so five years are a handful of elements rather than 1,800.
import { yearCells, squaresPath, handWidth, placeOf, dodge, wobble, arrow, head, ring, brace, type Day, type Milestone } from '../../lib/calendar';
import { fullDate, monthOfYear, isoDate } from '../../lib/dates';

interface Props {
  years: number[];
  days: Map<string, Day>;
  today: string;
  /** The first day anything was recorded. */
  from: string;
  milestones: Milestone[];
  yearNotes: { year: number; text: string }[];
  /** The id of the heading that names the strip. */
  labelledby: string;
}

const { years, days, today, from, milestones, yearNotes, labelledby } = Astro.props;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const CELL = 12;
const STEP = 15;
const HAND = 17;
const LINE = 19;
// Room before a year's January for its numeral, and after its December.
const LEAD = 76;
const TAIL = 44;

// The strip starts where the story does, in the month of its first note or first recorded day,
// rather than on months of empty squares.
const start = `${[from, ...milestones.flatMap((m) => (m.month ? [`${m.month}-01`] : m.week ? [m.week] : m.days))].filter(Boolean).sort()[0].slice(0, 7)}-01`;

// ---------- Across: one year after another ----------
let cursor = 0;
const blocks = years.map((year) => {
  const cells = yearCells(year, days, today, from).filter((c) => c.date >= start);
  // The first and last columns drawn: a year may start late (the first) or end early (this one).
  const skip = cells.length ? cells[0].week : 0;
  const columns = cells.length ? cells[cells.length - 1].week + 1 : 0;
  const block = { year, cells, skip, columns, left: cursor + LEAD - skip * STEP, offset: (new Date(Date.UTC(year, 0, 1)).getUTCDay() + 6) % 7 };
  cursor += LEAD + (columns - skip) * STEP - (STEP - CELL) + TAIL;
  return block;
});
const width = cursor;
const blockOf = new Map(blocks.map((b) => [b.year, b]));

/** The middle of a day's column, and its row; nothing for a day the strip doesn't draw. */
const spot = (date: string) => {
  const p = placeOf(date);
  const b = blockOf.get(p.year);
  return b && date >= start && date <= today && p.week >= b.skip && p.week < b.columns ? { x: b.left + p.week * STEP + CELL / 2, row: p.weekday } : undefined;
};

// ---------- The notes, slid along the strip until none sits on another ----------
interface Laid {
  m: Milestone;
  lines: string[];
  /** Width of the widest line. */
  w: number;
  /** A month's first and last columns, for a note that only knows the month. */
  span?: [number, number];
  /** The middle of each week's column its arrow ends in. */
  tips: number[];
  rings: { x: number; row: number }[];
  want: number;
  x: number;
}
const notes: Laid[] = milestones.flatMap((m): Laid[] => {
  const lines = m.text.split('\n');
  const w = Math.max(...lines.map((l) => handWidth(l, HAND)));
  if (m.month) {
    const [y, mo] = m.month.split('-').map(Number);
    const first = spot(`${m.month}-01`);
    const last = spot(isoDate(new Date(Date.UTC(y, mo, 0))));
    if (!first || !last) return [];
    const span: [number, number] = [first.x - CELL / 2, last.x + CELL / 2];
    return [{ m, lines, w, span, tips: [], rings: [], want: (span[0] + span[1]) / 2, x: 0 }];
  }
  const pins = (m.week ? [m.week] : m.days).map(spot);
  if (pins.some((p) => !p)) return [];
  const placed = pins as { x: number; row: number }[];
  const tips = [...new Set(placed.map((p) => p.x))];
  return [{ m, lines, w, tips, rings: m.week ? [] : placed, want: tips.reduce((a, b) => a + b, 0) / tips.length, x: 0 }];
});
for (const side of ['above', 'below'] as const) {
  const group = notes.filter((n) => n.m.position === side);
  dodge(group.map((n) => ({ want: n.want, width: n.w })), 18).forEach((x, i) => (group[i].x = x));
}

// ---------- Down: notes, month names, the days, notes ----------
const linesOn = (side: string) => Math.max(0, ...notes.filter((n) => n.m.position === side).map((n) => n.lines.length));
const aboveBottom = 8 + linesOn('above') * LINE;
const gridTop = aboveBottom + 44;
const gridBottom = gridTop + 6 * STEP + CELL;
const belowTop = gridBottom + 28;

const marks = yearNotes.flatMap((n) => {
  const b = blockOf.get(n.year);
  if (!b) return [];
  const x1 = b.left + b.skip * STEP;
  const x2 = b.left + b.columns * STEP - (STEP - CELL);
  // Under the notes beneath that year, however many lines they run to.
  const deepest = Math.max(0, ...notes.filter((l) => l.m.position === 'below' && l.x + l.w / 2 > x1 && l.x - l.w / 2 < x2).map((l) => l.lines.length));
  const y = deepest ? belowTop + deepest * LINE + 6 : gridBottom + 12;
  return [{ text: n.text, x1, x2, y }];
});
const height = Math.max(belowTop + linesOn('below') * LINE + 6, ...marks.map((k) => k.y + 46));

const drawn = notes.map((n) => {
  const above = n.m.position === 'above';
  const bow = wobble(n.m.text) * 5;
  const tipY = above ? gridTop - 3 : gridBottom + 3;
  const baseline = (i: number) => (above ? aboveBottom - 5 - (n.lines.length - 1 - i) * LINE : belowTop + 13 + i * LINE);
  const startY = above ? aboveBottom + 1 : belowTop - 3;
  const lines = n.lines.map((text, i) => ({ text, y: baseline(i) }));
  const tilt = { deg: wobble(n.lines.join('')) * 1.6, y: baseline(above ? n.lines.length - 1 : 0) };
  if (n.span) {
    const y = above ? gridTop - 18 : gridBottom + 5;
    return { n, lines, tilt, trunk: '', shafts: [] as string[], heads: '', rings: [] as string[], brace: brace(n.span[0], n.span[1], y, 4.5, !above) };
  }
  // The line leaves from the part of the note nearest its week.
  const mean = n.tips.reduce((a, b) => a + b, 0) / n.tips.length;
  const sx = Math.min(Math.max(mean, n.x - n.w / 2 + 10), n.x + n.w / 2 - 10);
  let trunk = '';
  let shafts: string[];
  if (n.tips.length === 1) {
    shafts = [arrow(sx, startY, n.tips[0], tipY, bow)];
  } else {
    // Two races, one note: the line forks, and each prong finds its own week.
    const forkY = startY + (tipY - startY) * 0.55;
    trunk = arrow(sx, startY, mean, forkY, bow);
    shafts = n.tips.map((tx) => arrow(mean, forkY, tx, tipY));
  }
  return {
    n,
    lines,
    tilt,
    trunk,
    shafts,
    heads: n.tips.map((tx) => head(tx, tipY, above)).join(''),
    rings: n.rings.map((p, i) => ring(p.x, gridTop + p.row * STEP + CELL / 2, wobble(`${n.m.text}${i}`))),
    brace: '',
  };
});

const shade = (level: number) =>
  squaresPath(blocks.flatMap((b) => b.cells.filter((c) => c.level === level).map((c) => [b.left + c.week * STEP, gridTop + c.weekday * STEP] as [number, number])), CELL);

const when = (m: Milestone) =>
  m.month ? monthOfYear(new Date(`${m.month}-01T00:00:00Z`)) : m.week ? `The week of ${fullDate(new Date(`${m.week}T00:00:00Z`))}` : m.days.map((d) => fullDate(new Date(`${d}T00:00:00Z`))).join(' and ');
---

<div class="frame">
<div class="strip" tabindex="0" role="group" aria-labelledby={labelledby}>
<div class="track">
<svg
  class="days"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  style={`--w: ${width}`}
  role="img"
  aria-label={`Every day from ${fullDate(new Date(`${from}T00:00:00Z`))}, shaded by time spent moving`}
  data-top={gridTop}
  data-step={STEP}
  data-cell={CELL}
  data-start={start}
  data-years={JSON.stringify(blocks.map((b) => [b.year, b.left, b.offset, b.skip, b.columns]))}
>
  {blocks.map((b) => (
    <>
      <text class="numeral" x={b.left + b.skip * STEP - 16} y={gridTop + (6 * STEP + CELL) / 2 + 9} text-anchor="end">{b.year}</text>
      {MONTHS.map((name, m) => {
        const first = b.cells.find((c) => c.month === m && c.day === 0);
        return first && <text class="month" x={b.left + first.week * STEP} y={gridTop - 6}>{name}</text>;
      })}
    </>
  ))}
  <path class="before" d={shade(-1)} />
  {[0, 1, 2, 3, 4].map((level) => <path class={`l${level}`} d={shade(level)} />)}

  {drawn.map((d) => (
    <g class="note" data-days={d.n.m.days.join(' ') || undefined} data-week={d.n.m.week} data-month={d.n.m.month} data-position={d.n.m.position}>
      <g transform={`rotate(${Math.round(d.tilt.deg * 10) / 10} ${Math.round(d.n.x)} ${d.tilt.y})`}>
        {d.lines.map((l) => <text x={Math.round(d.n.x)} y={l.y} text-anchor="middle">{l.text}</text>)}
      </g>
      {d.trunk && <path class="trunk" d={d.trunk} />}
      {d.shafts.map((s) => <path class="shaft" d={s} />)}
      {d.heads && <path d={d.heads} />}
      {d.rings.map((s) => <path class="ring" d={s} />)}
      {d.brace && <path class="brace" d={d.brace} />}
    </g>
  ))}
  {marks.map((k) => (
    <g class="note year-note">
      <path class="brace" d={brace(k.x1, k.x2, k.y, 9)} />
      <text x={Math.round((k.x1 + k.x2) / 2)} y={k.y + 37} text-anchor="middle">{k.text}</text>
    </g>
  ))}
</svg>
</div>
</div>
</div>

<ul class="visually-hidden">
  {milestones.map((m) => <li>{when(m)}: {m.text.replace(/\n/g, ' ')}</li>)}
  {yearNotes.map((n) => <li>{n.year}: {n.text}</li>)}
</ul>

<style>
  /* The strip fades in at one side and out at the other, as the maps fade into the page. */
  .strip {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .strip.dragging {
    cursor: grabbing;
  }

  /* The fade would swallow a focus ring drawn on the strip itself, so its frame wears it, inside
     its edge: the section is laid out lazily, and that clips anything drawn outside it. */
  .strip:focus-visible {
    outline: none;
  }

  .frame:has(> .strip:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: var(--radius);
  }

  /* Room at either end, so the first year and the last start clear of the fade. */
  .track {
    display: flex;
    width: max-content;
    padding-inline: 9vw;
  }

  @media (max-width: 40rem) {
    .strip {
      mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    }

    .track {
      padding-inline: 7vw;
    }
  }

  .days {
    display: block;
    flex: none;
    width: calc(var(--w) * 1px);
    height: auto;
    font-family: var(--font-serif);
    /* The pencil the notes are written in: the colour of the routes, pressed a little harder. */
    --hand: color-mix(in oklab, var(--route) 80%, var(--ink));
  }

  /* A phone draws the strip a size smaller: half a year still fits across the screen. */
  @media (max-width: 40rem) {
    .days {
      width: calc(var(--w) * 0.86px);
    }
  }

  .numeral {
    font-size: 26px;
    font-variant-numeric: lining-nums;
    fill: var(--ink-muted);
  }

  .month {
    font-size: 11px;
    fill: var(--ink-muted);
  }

  .before {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
  }

  .l0 {
    fill: var(--rule);
  }

  .l1 {
    fill: color-mix(in oklab, var(--route) 24%, var(--paper));
  }

  .l2 {
    fill: color-mix(in oklab, var(--route) 46%, var(--paper));
  }

  .l3 {
    fill: color-mix(in oklab, var(--route) 72%, var(--paper));
  }

  .l4 {
    fill: var(--route);
  }

  .note text {
    font-family: var(--font-hand);
    font-size: 17px;
    fill: var(--hand);
  }

  .note path {
    fill: none;
    stroke: var(--hand);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A ring sits on the squares, so it is drawn a touch darker to hold its own on the brightest. */
  .note .ring {
    stroke: color-mix(in oklab, var(--hand) 80%, var(--ink));
    stroke-width: 1.5;
  }

  .year-note text {
    font-size: 18px;
  }
</style>
