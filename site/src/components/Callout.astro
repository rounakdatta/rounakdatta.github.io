---
// An aside in a note, set off from the prose: <Callout>…</Callout>, or <Callout title="Why">…</Callout>.
// Quiet on purpose: a ruled margin and a tint, never an alarm colour.
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="callout">
  {title && <p class="callout-title">{title}</p>}
  <slot />
</aside>

<style>
  .callout {
    margin: 1.6em 0;
    padding: 0.8em 1.1em;
    border-left: 2px solid var(--accent);
    background: var(--paper-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .callout-title {
    margin: 0 0 0.3em;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }

  .callout :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
