---
import { tagSlug, type Note } from '../lib/notes';
import { dayInYear } from '../lib/dates';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;

// Grouped under year headings, newest first; within a year only day and month are needed.
const years = new Map<number, Note[]>();
for (const note of notes) {
  const year = note.data.date.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), note]);
}
---

{[...years].map(([year, list]) => (
  <section class="year" aria-labelledby={`y${year}`}>
    <h2 id={`y${year}`} class="year-heading">{year}</h2>
    <ol class="notes">
      {list.map((note) => (
        <li>
          <time datetime={note.data.date.toISOString().slice(0, 10)}>{dayInYear(note.data.date)}</time>
          <div>
            <a href={`/notes/${note.id}/`} class="title">{note.data.title}</a>
            {note.data.tags.map((tag) => <a class="tag" href={`/notes/tags/${tagSlug(tag)}/`}>{tag}</a>)}
          </div>
        </li>
      ))}
    </ol>
  </section>
))}

<style>
  .year {
    display: grid;
    grid-template-columns: 4.5em 1fr;
    column-gap: 1em;
    margin-top: 1.6em;
  }

  .year-heading {
    margin: 0;
    font-size: 1em;
    font-weight: 600;
    color: var(--ink-muted);
    font-variant-numeric: oldstyle-nums;
  }

  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes li {
    display: grid;
    grid-template-columns: 3.6em 1fr;
    column-gap: 0.75em;
    margin: 0 0 0.55em;
  }

  time {
    color: var(--ink-muted);
    font-size: 0.9em;
    line-height: 1.75;
  }

  .title {
    font-weight: 600;
    text-decoration-color: transparent;
  }

  .title:hover {
    text-decoration-color: currentColor;
  }

  .tag {
    margin-left: 0.6em;
    font-size: 0.8em;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .tag:hover {
    color: var(--accent);
  }

  /* A phone puts the year above its notes, and each date above its title. */
  @media (max-width: 34rem) {
    .year {
      grid-template-columns: 1fr;
    }

    .year-heading {
      margin-bottom: 0.4em;
      padding-bottom: 0.2em;
      border-bottom: 1px solid var(--rule);
    }

    .notes li {
      grid-template-columns: 1fr;
    }

    time {
      font-size: 0.8em;
      line-height: 1.4;
    }
  }
</style>
