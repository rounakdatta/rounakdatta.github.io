---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { Content as Intro } from '../content/home/intro.md';
import { Content as Story } from '../content/home/story.md';
import profile from '../assets/images/profile.jpeg';
import { SITE, ELSEWHERE } from '../lib/site';

// Structured data so a search engine knows whose site this is.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  jobTitle: 'Software engineer',
  homeLocation: { '@type': 'Place', name: 'Bengaluru, India' },
  sameAs: ELSEWHERE.map((e) => e.href),
};
---

<BaseLayout type="profile">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />

  <section class="intro">
    <div class="portrait">
      <div class="frame">
        <Image src={profile} alt="Rounak, smiling, in front of a weathered wooden door" width={140} height={140} layout="fixed" priority class="photo" />
        <span class="rickshaw" aria-hidden="true">🛺</span>
      </div>
      <p class="place"><Icon name="map-pin" /> Bengaluru</p>
    </div>
    <div class="intro-text prose">
      <Intro />
    </div>
  </section>


  <div class="story prose">
    <Story />
  </div>
</BaseLayout>

<style>
  .intro {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 2.25rem);
    margin-bottom: 2.2rem;
  }

  .portrait {
    flex-shrink: 0;
    text-align: center;
  }

  .frame {
    position: relative;
    width: 140px;
    height: 140px;
  }

  .photo {
    display: block;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
  }

  /* The rickshaw parks at nine o'clock. The emoji faces left; turned a quarter it heads down. */
  .rickshaw {
    position: absolute;
    top: 70px;
    left: -28px;
    transform: translateY(-50%) rotate(-90deg);
    font-size: 1.5rem;
    line-height: 1;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.15));
    pointer-events: none;
  }

  .place {
    margin: 0.7rem 0 0;
    font-size: 0.8em;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }

  .intro-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .story :global(h2) {
    font-size: 1.15em;
  }

  /* A phone stacks the photo over the words. */
  @media (max-width: 34rem) {
    .intro {
      flex-direction: column;
      text-align: left;
      align-items: flex-start;
    }

    .portrait {
      align-self: center;
    }
  }
</style>
