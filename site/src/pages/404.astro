---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import art from '../assets/images/excusez_moi.png';
---

<BaseLayout title="Page not found" description="There is no page at this address." noindex>
  <div class="lost">
    <h1>404</h1>
    <Image src={art} alt="A cartoon of Rounak looking up from his phone, asking “Excusez-moi..?”" width={260} densities={[1, 2, 3]} format="webp" priority class="art" />
    <a class="home" href="/">Take me home</a>
  </div>
</BaseLayout>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 1.2em;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 5em;
    line-height: 1;
    color: var(--ink-muted);
    opacity: 0.35;
  }

  .art {
    width: 240px;
    height: auto;
  }

  .home {
    padding: 0.45em 1.4em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
  }

  .home:hover {
    border-color: var(--accent);
  }
</style>
