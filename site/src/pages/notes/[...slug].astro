---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { publishedNotes, summaryOf, minutesToRead, tagSlug, type Note } from '../../lib/notes';
import { fullDate, isoDate } from '../../lib/dates';

export async function getStaticPaths() {
  // Built from published notes only: a draft has no page, not even an unlisted one.
  const notes = await publishedNotes();
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}

interface Props {
  note: Note;
  newer?: Note;
  older?: Note;
}

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
const { title, date, updated, tags } = note.data;
const minutes = minutesToRead(note);
---

<BaseLayout title={title} description={summaryOf(note)} type="article" published={date} modified={updated}>
  <article>
    <header class="note-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={isoDate(date)}>{fullDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <span class="tags">
              {tags.map((tag, i) => (
                <>{i > 0 && ', '}<a href={`/notes/tags/${tagSlug(tag)}/`}>{tag}</a></>
              ))}
            </span>
          </>
        )}
      </p>
      {updated && <p class="meta updated">Updated <time datetime={isoDate(updated)}>{fullDate(updated)}</time></p>}
    </header>

    <div class="prose note-body">
      <Content />
    </div>
  </article>

  <nav class="next-steps" aria-label="More notes">
    {older && (
      <a class="step older" href={`/notes/${older.id}/`} rel="prev">
        <span class="label"><Icon name="arrow-left" /> Older</span>
        <span class="step-title">{older.data.title}</span>
      </a>
    )}
    {newer && (
      <a class="step newer" href={`/notes/${newer.id}/`} rel="next">
        <span class="label">Newer <Icon name="arrow-right" /></span>
        <span class="step-title">{newer.data.title}</span>
      </a>
    )}
    <a class="all" href="/notes/">All notes</a>
  </nav>
</BaseLayout>

<style>
  .note-head {
    margin-bottom: 2.2em;
  }

  .note-head h1 {
    margin-bottom: 0.35em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin: 0;
    font-size: 0.9em;
    color: var(--ink-muted);
  }

  .meta a {
    color: inherit;
  }

  .updated {
    margin-top: 0.2em;
    font-style: italic;
  }

  .note-body {
    line-height: 1.65;
  }

  .next-steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em 2em;
    margin-top: 3em;
    padding-top: 1.4em;
    border-top: 1px solid var(--rule);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    text-decoration: none;
  }

  .step .label {
    font-size: 0.9em;
  }

  .step-title {
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .step:hover .step-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .newer {
    grid-column: 2;
    text-align: right;
    align-items: flex-end;
  }

  .all {
    grid-column: 1 / -1;
    justify-self: center;
    font-size: 0.92em;
  }

  @media (max-width: 34rem) {
    .next-steps {
      grid-template-columns: 1fr;
    }

    .newer {
      grid-column: 1;
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
