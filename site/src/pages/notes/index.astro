---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { publishedNotes, tagSlug } from '../../lib/notes';

const notes = await publishedNotes();

// Topics are only worth a row when they gather more than one note.
const counts = new Map<string, number>();
for (const note of notes) for (const tag of note.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const topics = [...counts].filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Notes" description="Stories, ideas, half-baked thoughts and questions, lest we forget: notes by Rounak Datta on software, self-hosting and travel.">
  <h1>Notes</h1>
  <p class="lede">Stories, ideas, half-baked thoughts and questions, lest we forget.</p>

  {topics.length > 0 && (
    <nav class="topics" aria-label="Topics">
      <span class="label">Topics</span>
      <ul>
        {topics.map(([tag, n]) => (
          <li><a href={`/notes/tags/${tagSlug(tag)}/`}>{tag}</a> <span class="count">{n}</span></li>
        ))}
      </ul>
    </nav>
  )}

  <NoteList notes={notes} />
</BaseLayout>

<style>
  .lede {
    color: var(--ink-muted);
    font-style: italic;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3em 1em;
    margin: 1.4em 0 2em;
    font-size: 0.92em;
  }

  .topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.1em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .count {
    color: var(--ink-muted);
    font-size: 0.85em;
  }
</style>
