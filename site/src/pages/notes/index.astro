---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { publishedNotes } from '../../lib/notes';

const notes = await publishedNotes();
---

<BaseLayout title="Notes" description="Stories, ideas, half-baked thoughts and questions, lest we forget: notes by Rounak Datta on software, self-hosting and travel.">
  <h1>Notes</h1>
  <p class="lede">Stories, ideas, half-baked thoughts and questions, lest we forget.</p>

  <NoteList notes={notes} />
</BaseLayout>

<style>
  .lede {
    color: var(--ink-muted);
    font-style: italic;
  }
</style>
