---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { chapters } from '../../lib/journal';
import { fitRoute } from '../../lib/routes';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const books = await getCollection('books');

// A journal kept on this site is only shown once it has something in it.
const journals = all.filter((p) => p.data.internalUrl && !(p.data.internalUrl === '/reading/' && books.length === 0));
const repos = await Promise.all(
  all.filter((p) => !p.data.internalUrl).map(async (project) => ({ project, Content: (await render(project)).Content })),
);

// The fitness journal introduces itself with a few of its own routes.
const shapes = chapters.slice(0, 6).map((c) => fitRoute(c.route, 64, 64, 6));
const statusLabel = { active: 'Active', maintained: 'Maintained', finished: 'Finished', retired: 'Retired' } as const;
---

<BaseLayout title="Projects" description="Software Rounak Datta builds and keeps building: a self-hosted homelab, Nix dotfiles, and the fitness journal on this site.">
  <h1>Projects</h1>

  {journals.length > 0 && (
    <ul class="journals">
      {journals.map((p) => (
        <li>
          <a class="journal" href={p.data.internalUrl}>
            {p.data.internalUrl === '/fitness/' && (
              <svg class="shapes" viewBox={`0 0 ${64 * shapes.length} 64`} aria-hidden="true">
                {shapes.map((s, i) => <path d={s.d} transform={`translate(${i * 64} 0)`} />)}
              </svg>
            )}
            <span class="journal-title">{p.data.title}</span>
            {p.data.description && <span class="journal-description">{p.data.description}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}

  <ul class="repos">
    {repos.map(({ project, Content }) => {
      const { title, logo, year, status, stack, github, url } = project.data;
      const facts = [year && `Since ${year}`, status && statusLabel[status], stack.join(', ')].filter(Boolean);
      return (
        <li class="repo">
          {logo && <Image src={logo} alt="" width={112} height={112} layout="fixed" fit="contain" class="logo" />}
          <div class="repo-text">
            <h2>{title}</h2>
            <div class="prose repo-body"><Content /></div>
            {facts.length > 0 && <p class="facts">{facts.join(' · ')}</p>}
            <p class="links">
              {github && <a href={github}>Code <Icon name="arrow-up-right" /></a>}
              {url && <a href={url}>Website <Icon name="arrow-up-right" /></a>}
            </p>
          </div>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .journals,
  .repos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journals {
    margin-bottom: 2.5em;
  }

  .journal {
    display: grid;
    gap: 0.2em;
    padding: 1.1em 1.25em 1.2em;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .journal:hover {
    border-color: color-mix(in oklab, var(--route) 45%, var(--rule));
  }

  .shapes {
    height: 2.6em;
    width: auto;
    max-width: 100%;
    margin-bottom: 0.5em;
  }

  .shapes path {
    fill: none;
    stroke: var(--route);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .journal-title {
    font-weight: 600;
    font-size: 1.1em;
  }

  .journal-description {
    color: var(--ink-muted);
  }

  .repo {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5em;
    padding: 1.6em 0;
    border-top: 1px solid var(--rule);
  }

  .logo {
    grid-column: 2;
    grid-row: 1;
    width: 112px;
    height: 112px;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .repo-text {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .repo h2 {
    margin: 0 0 0.35em;
    font-size: 1.2em;
  }

  .repo-body :global(p) {
    margin-bottom: 0.6em;
  }

  .facts {
    margin: 0 0 0.3em;
    font-size: 0.88em;
    color: var(--ink-muted);
  }

  .links {
    display: flex;
    gap: 1.25em;
    margin: 0;
    font-size: 0.95em;
  }

  /* On a phone the picture sits above the words, small. */
  @media (max-width: 34rem) {
    .repo {
      grid-template-columns: 1fr;
      gap: 0.8em;
    }

    .logo {
      grid-column: 1;
      width: 72px;
      height: 72px;
    }

    .repo-text {
      grid-row: 2;
    }
  }
</style>
