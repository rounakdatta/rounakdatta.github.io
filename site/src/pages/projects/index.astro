---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

// The Reading and Fitness projects live on this site, so they lead as tiles of their own.
const special = all.filter((p) => p.data.internalUrl);
const repos = await Promise.all(
  all.filter((p) => !p.data.internalUrl).map(async (project) => ({ project, Content: (await render(project)).Content })),
);
const statusLabel = { active: 'Active', maintained: 'Maintained', finished: 'Finished', retired: 'Retired' } as const;
---

<BaseLayout title="Projects" description="Software Rounak Datta builds and keeps building: a self-hosted homelab, Nix dotfiles, and the fitness journal on this site.">
  <h1>Projects</h1>

  {special.length > 0 && (
    <div class="special-projects">
      {special.map((p) => (
        <a href={p.data.internalUrl} class="special-project">
          <span class="special-title">{p.data.title}</span>
        </a>
      ))}
    </div>
  )}

  <ul class="repos">
    {repos.map(({ project, Content }) => {
      const { title, logo, year, status, stack, github, url } = project.data;
      const facts = [year && `Since ${year}`, status && statusLabel[status], stack.join(', ')].filter(Boolean);
      return (
        <li class="repo">
          {logo && <Image src={logo} alt="" width={112} height={112} layout="fixed" fit="contain" class="logo" />}
          <div class="repo-text">
            <h2>{title}{project.data.featured && <span class="featured-badge">Featured</span>}</h2>
            <div class="prose repo-body"><Content /></div>
            {facts.length > 0 && <p class="facts">{facts.join(' · ')}</p>}
            <p class="links">
              {github && <a href={github}>Code <Icon name="arrow-up-right" /></a>}
              {url && <a href={url}>Website <Icon name="arrow-up-right" /></a>}
            </p>
          </div>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .repos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .special-projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0.5em 0 2.5em;
  }

  .special-project {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem;
    background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 3%, var(--paper)), color-mix(in oklab, var(--accent) 8%, var(--paper)));
    border: 1px solid color-mix(in oklab, var(--accent) 22%, var(--paper));
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 0.2s var(--ease-out), border-color 0.2s, background 0.2s;
  }

  .special-project:hover {
    background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 6%, var(--paper)), color-mix(in oklab, var(--accent) 12%, var(--paper)));
    border-color: color-mix(in oklab, var(--accent) 35%, var(--paper));
    transform: translateY(-2px);
  }

  .special-title {
    font-size: 0.9em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-align: center;
  }

  @media (max-width: 34rem) {
    .special-projects {
      grid-template-columns: 1fr;
    }
  }

  .featured-badge {
    margin-left: 0.6em;
    padding: 0.15em 0.5em;
    border-radius: 3px;
    background: var(--accent);
    color: var(--paper);
    font-size: 0.55em;
    font-weight: 400;
    vertical-align: 0.3em;
    letter-spacing: 0.02em;
  }

  .repo {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5em;
    padding: 1.6em 0;
    border-top: 1px solid var(--rule);
  }

  .logo {
    grid-column: 2;
    grid-row: 1;
    width: 112px;
    height: 112px;
    object-fit: contain;
    border-radius: var(--radius);
  }

  /* Logos are drawn for white paper (homelab's name is black ink), so at night they sit on a light card. */
  @media (prefers-color-scheme: dark) {
    .logo {
      background: #f4f1e6;
      padding: 6px;
    }
  }

  .repo-text {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .repo h2 {
    margin: 0 0 0.35em;
    font-size: 1.2em;
  }

  .repo-body :global(p) {
    margin-bottom: 0.6em;
  }

  .facts {
    margin: 0 0 0.3em;
    font-size: 0.88em;
    color: var(--ink-muted);
  }

  .links {
    display: flex;
    gap: 1.25em;
    margin: 0;
    font-size: 0.95em;
  }

  /* On a phone the picture sits above the words, small. */
  @media (max-width: 34rem) {
    .repo {
      grid-template-columns: 1fr;
      gap: 0.8em;
    }

    .logo {
      grid-column: 1;
      width: 72px;
      height: 72px;
    }

    .repo-text {
      grid-row: 2;
    }
  }
</style>
