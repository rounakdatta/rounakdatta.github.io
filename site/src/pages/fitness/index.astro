  }

  .polaroid {
    display: block;
    width: 100%;
    margin: 0;
    padding: 4.5% 4.5% 14%;
    border: 0;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.32), 0 2px 8px rgba(0, 0, 0, 0.16);
