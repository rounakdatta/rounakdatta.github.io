---
import { getImage, Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Calendar from '../../components/fitness/Calendar.astro';
import { activities, totalsOf, km, kmTenths, sportIcon, lastUpdated } from '../../lib/fitness';
import { daysOf } from '../../lib/calendar';
import { compactPath } from '../../lib/routes';
import { placePolaroids, pointsOf, along, coverage, type Point } from '../../lib/polaroids';
import { chapters, milestones, yearNotes, type Chapter } from '../../lib/journal';
import { monthOfYear, isoDate } from '../../lib/dates';

const all = totalsOf(activities);
const days = daysOf(activities);
const today = isoDate(lastUpdated);
const years = [...new Set(activities.map((a) => Number(a.date.slice(0, 4))))].sort();
const tooltipDays = Object.fromEntries([...days].map(([date, d]) => [date, d.summary]));
// The runner and the rider at the start of the two arcs (Phosphor's filled icons, drawn inline).
const RUNNER = 'M120,56a32,32,0,1,1,32,32A32,32,0,0,1,120,56Zm103.28,74.08a8,8,0,0,0-10.6-4c-.25.12-26.71,10.72-72.18-20.19-52.29-35.54-88-7.77-89.51-6.57a8,8,0,1,0,10,12.48c.26-.21,25.12-19.5,64.07,3.27-4.25,13.35-12.76,31.82-25.25,47-18.56,22.48-41.11,32.56-67,30A8,8,0,0,0,31.2,208a92.29,92.29,0,0,0,9.34.47c27.38,0,52-12.38,71.63-36.18.57-.69,1.14-1.4,1.69-2.1C133.31,175.29,168,190.3,168,232a8,8,0,0,0,16,0c0-24.65-10.08-45.35-29.15-59.86a104.29,104.29,0,0,0-31.31-15.81A169.31,169.31,0,0,0,139,124c26.14,16.09,46.84,20,60.69,20,12.18,0,19.06-3,19.67-3.28A8,8,0,0,0,223.28,130.08Z';
const RIDER = 'M54.46,164.71,82.33,126.5a48,48,0,1,1-12.92-9.44L41.54,155.29a8,8,0,1,0,12.92,9.42ZM208,112a47.81,47.81,0,0,0-16.93,3.09L214.91,156A8,8,0,1,1,201.09,164l-23.83-40.86A48,48,0,1,0,208,112ZM165.93,72H192a8,8,0,0,1,8,8,8,8,0,0,0,16,0,24,24,0,0,0-24-24H152a8,8,0,0,0-6.91,12l11.65,20H99.26L82.91,60A8,8,0,0,0,76,56H48a8,8,0,0,0,0,16H71.41L85.12,95.51,69.41,117.06a47.87,47.87,0,0,1,12.92,9.44l11.59-15.9L125.09,164A8,8,0,1,0,138.91,156l-30.32-52h57.48l11.19,19.17a48.11,48.11,0,0,1,13.81-8.08Z';

// ---------- The cards ----------

// One map, two shapes: landscape on wide screens, portrait on phones, each with its own drawing.
const WIDE = { width: 1200, height: 800 };
const TALL = { width: 900, height: 1000 };
// A polaroid is 23% of the map's width on a wide screen and 30% on a phone; in each map's own
// units that is the footprint the group is laid out with.
const PRINT_WIDE = { width: 276, height: 240 };
const PRINT_TALL = { width: 270, height: 234 };
const MAX_WIDE = 5;
const MAX_TALL = 4;

// Maps are flat colour: WebP at 72 holds them as well as AVIF does, and encodes far faster.
const plateSet = async (image: ImageMetadata, widths: number[]) => {
  const all = await Promise.all(widths.map((width) => getImage({ src: image, width, format: 'webp', quality: 72 })));
  return { src: all[1].src, srcset: all.map((v, i) => `${v.src} ${widths[i]}w`).join(', ') };
};

const thumbnail = async (image: ImageMetadata) => {
  const widths = [240, 480, 800].filter((w) => w <= image.width);
  const all = await Promise.all(widths.map((width) => getImage({ src: image, width, height: Math.round(width * 0.75), fit: 'cover', format: 'avif', quality: 60 })));
  return { src: all[0].src, srcset: all.map((v, i) => `${v.src} ${widths[i]}w`).join(', ') };
};

const twelveHour = (hhmm: string) => {
  const [h, m] = hhmm.split(':').map(Number);
  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
};

const duration = (seconds: number) => {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  return h ? `${h} h ${m} min` : `${m} min`;
};

const cards = await Promise.all(
  chapters.map(async (c: Chapter, i) => {
    const wideRoute = c.plate ? along(pointsOf(c.plate.d), 6) : [];
    const tallRoute = c.plateTall ? along(pointsOf(c.plateTall.d), 6) : [];
    const shown = c.photos.slice(0, MAX_WIDE);
    const wideSlots = placePolaroids(wideRoute, shown.length, { frame: WIDE, size: PRINT_WIDE });
    const tallSlots = placePolaroids(tallRoute, Math.min(shown.length, MAX_TALL), { frame: TALL, size: PRINT_TALL, centre: { x: 0.5, y: 0.45 } });
    // What the photos hide of the route, reported on the card, so a test can tell "placed well" from "never placed".
    const hidden = coverage(wideRoute, wideSlots.map((s) => [s.x * WIDE.width, s.y * WIDE.height] as Point), PRINT_WIDE);
    return {
      c,
      first: i === 0,
      side: i % 2 === 0 ? 'odd' : 'even',
      plates: c.plates && {
        light: await plateSet(c.plates.light, [600, 900, 1200]),
        dark: await plateSet(c.plates.dark, [600, 900, 1200]),
        // A phone's map spans the screen: 800 covers a 400px-wide phone at 2×.
        tallLight: await plateSet(c.plates.tallLight, [500, 800, 960]),
        tallDark: await plateSet(c.plates.tallDark, [500, 800, 960]),
      },
      wide: c.plate ? compactPath(c.plate.d, 0.8) : '',
      tall: c.plateTall ? compactPath(c.plateTall.d, 0.8) : '',
      photos: await Promise.all(
        shown.map(async (src, k) => ({ ...(await thumbnail(src)), wide: wideSlots[k], tall: tallSlots[k] })),
      ),
      hidden: Math.round(hidden * 100),
      when: new Date(`${c.date}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
      start: twelveHour(c.startTime),
      meta: [c.place, c.distance > 0 && `${kmTenths(c.distance)} km`, c.days.length > 1 ? `${c.days.length} days` : duration(c.movingTime)].filter(Boolean) as string[],
    };
  }),
);

// ---------- The sketches in the margins ----------

const drawings = import.meta.glob<ImageMetadata>('../../assets/illustrations/*.png', { eager: true, import: 'default' });
const sketch = (name: string) => drawings[`../../assets/illustrations/${name}.png`];
const LEFT = ['bottle', 'filter_coffee', 'cycle', 'dosa', 'alarm', 'kudos', 'helmet', 'shoes', 'garmin', 'strava', 'socks', 'cap', 'arm_sleeve', 'cycle_bell'];
const RIGHT = ['sunscreen', 'socks', 'helmet', 'shoes', 'filter_coffee', 'dosa', 'garmin', 'strava', 'cycle', 'kudos', 'arm_sleeve', 'cap', 'alarm', 'cycle_bell'];
const TILT_L = [-12, 18, -8, 22, -15, 10, -20, 15, -10, 8, -18, 25, -5, 12];
const TILT_R = [15, -22, 8, -18, 12, -25, 20, -12, 5, -15, 18, -8, 22, -20];
const NUDGE_L = [20, 40, 15, 50, 25, 35, 20, 45, 30, 15, 50, 25, 40, 20];
const NUDGE_R = [25, 40, 15, 50, 30, 20, 45, 25, 35, 15, 50, 30, 20, 40];
const thumbs = Object.fromEntries(
  await Promise.all(
    [...new Set([...LEFT, ...RIGHT])].map(async (name) => {
      const widths = [200, 320];
      const set = await Promise.all(widths.map((width) => getImage({ src: sketch(name), width, format: 'webp', quality: 70 })));
      return [name, { src: set[1].src, srcset: set.map((v, i) => `${v.src} ${widths[i]}w`).join(', ') }];
    }),
  ),
);
const sketches = [
  ...LEFT.map((name, i) => ({ name, side: 'left', top: i * 7, nudge: NUDGE_L[i], tilt: TILT_L[i] })),
  ...RIGHT.map((name, i) => ({ name, side: 'right', top: 3 + i * 7, nudge: NUDGE_R[i], tilt: TILT_R[i] })),
];
---

<BaseLayout
  title="The Fitness Project"
  description={`${km(all.footAndBike)} km on foot and by bike since ${monthOfYear(new Date(`${all.first}T00:00:00Z`))}: Rounak Datta's running and riding journal, with the routes, the photos and the days in between.`}
>
  <Font slot="head" cssVariable="--font-hand" />
  <!-- Before the first paint: if motion is welcome, the cards start undrawn and play as they arrive. -->
  <script is:inline slot="head">
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
  </script>

  <div class="sketches" aria-hidden="true">
    {sketches.map((s) => (
      <img
        src={thumbs[s.name].src}
        srcset={thumbs[s.name].srcset}
        sizes="(max-width: 40rem) 110px, clamp(180px, 16vw, 320px)"
        alt=""
        loading="lazy"
        decoding="async"
        class={`sketch ${s.side}`}
        style={`top: ${s.top}%; --nudge: ${s.nudge}px; --tilt: ${s.tilt}deg`}
      />
    ))}
  </div>

  <h1 class="title">The Fitness Project</h1>

  <div class="journey full" role="img" aria-label={`${km(all.run)} km of running and ${km(all.ride)} km of cycling`}>
    <svg class="arcs wide-arcs" viewBox="0 0 1000 180" aria-hidden="true">
      <path class="arc" d="M 50 70 Q 500 10 950 70" />
      <path class="figure-icon" transform="translate(18, 43) scale(0.14)" d={RUNNER} />
      <g transform="translate(950, 70) rotate(8)">
        <text x="10" y="-6" class="figure">{km(all.run)}</text>
        <text x="10" y="10" class="unit">kms of running</text>
      </g>
      <path class="arc" d="M 50 140 Q 500 80 950 140" />
      <path class="figure-icon" transform="translate(15, 108) scale(0.14)" d={RIDER} />
      <g transform="translate(950, 140) rotate(8)">
        <text x="10" y="-6" class="figure">{km(all.ride)}</text>
        <text x="10" y="10" class="unit">kms of cycling</text>
      </g>
    </svg>
    <svg class="arcs narrow-arcs" viewBox="0 0 500 160" aria-hidden="true">
      <path class="arc" d="M 70 55 Q 250 15 380 55" />
      <path class="figure-icon" transform="translate(38, 30) scale(0.12)" d={RUNNER} />
      <text x="388" y="50" class="figure">{km(all.run)}</text>
      <text x="388" y="64" class="unit">kms of running</text>
      <path class="arc" d="M 70 115 Q 250 75 380 115" />
      <path class="figure-icon" transform="translate(36, 88) scale(0.12)" d={RIDER} />
      <text x="388" y="110" class="figure">{km(all.ride)}</text>
      <text x="388" y="124" class="unit">kms of cycling</text>
    </svg>
  </div>

  <section class="places full" aria-labelledby="places">
    <h2 id="places" class="section-title">Places we go</h2>

    {cards.map(({ c, first, side, plates, wide, tall, photos, hidden, when, start, meta }) => (
      <article class:list={['place', side]} id={c.slug} aria-labelledby={`t-${c.slug}`}>
        <header class="place-head">
          <p class="when"><time datetime={c.date.slice(0, 7)}>{when}</time></p>
          <span class="sport"><Icon name={sportIcon(c.type)} size="2.6rem" /></span>
          <h3 id={`t-${c.slug}`} class="place-title">{c.title}</h3>
          {c.tagline && <p class="tagline">{c.tagline}</p>}
        </header>

        <div class="card" data-hidden={hidden}>
          <div class="ground">
          {plates ? (
            <picture class="plate">
              <source media="(max-width: 40rem) and (prefers-color-scheme: dark)" srcset={plates.tallDark.srcset} sizes="100vw" />
              <source media="(max-width: 40rem)" srcset={plates.tallLight.srcset} sizes="100vw" />
              <source media="(prefers-color-scheme: dark)" srcset={plates.dark.srcset} sizes="(max-width: 56rem) 100vw, 760px" />
              <img
                src={plates.light.src}
                srcset={plates.light.srcset}
                sizes="(max-width: 56rem) 100vw, 760px"
                alt=""
                width={WIDE.width}
                height={WIDE.height}
                loading={first ? 'eager' : 'lazy'}
                fetchpriority={first ? 'high' : undefined}
                decoding="async"
              />
            </picture>
          ) : (
            <div class="plate blank" aria-hidden="true"></div>
          )}

          {wide && (
            <svg class="route wide" viewBox={`0 0 ${WIDE.width} ${WIDE.height}`} role="img" aria-label={`The route of ${c.title}`}>
              <path class="casing" d={wide} pathLength="1" />
              <path class="line" id={`r-${c.slug}-w`} d={wide} pathLength="1" />
              <path class="marker" d="M11 0L-8 7L-4 0L-8-7Z">
                <animateMotion begin="indefinite" dur="2.4s" fill="freeze" rotate="auto" calcMode="spline" keyPoints="0;1" keyTimes="0;1" keySplines="0.45 0 0.25 1">
                  <mpath href={`#r-${c.slug}-w`} />
                </animateMotion>
              </path>
            </svg>
          )}
          {tall && (
            <svg class="route tall" viewBox={`0 0 ${TALL.width} ${TALL.height}`} role="img" aria-label={`The route of ${c.title}`}>
              <path class="casing" d={tall} pathLength="1" />
              <path class="line" id={`r-${c.slug}-t`} d={tall} pathLength="1" />
              <path class="marker" d="M11 0L-8 7L-4 0L-8-7Z">
                <animateMotion begin="indefinite" dur="2.4s" fill="freeze" rotate="auto" calcMode="spline" keyPoints="0;1" keyTimes="0;1" keySplines="0.45 0 0.25 1">
                  <mpath href={`#r-${c.slug}-t`} />
                </animateMotion>
              </path>
            </svg>
          )}
          </div>

          <p class="start" aria-hidden="true">{start}</p>

          {photos.length > 0 && (
            <ul class="polaroids">
              {photos.map((p, k) => (
                <li
                  class:list={['slot', { 'wide-only': !p.tall }]}
                  style={`--i: ${k}; --x: ${p.wide.x}; --y: ${p.wide.y}; --r: ${p.wide.r}deg${p.tall ? `; --xm: ${p.tall.x}; --ym: ${p.tall.y}; --rm: ${p.tall.r}deg` : ''}`}
                >
                  <button type="button" class="polaroid" aria-pressed="false" aria-label={`Photo ${k + 1} of ${photos.length}, ${c.title}`}>
                    <img
                      src={p.src}
                      srcset={p.srcset}
                      sizes="(max-width: 40rem) 27vw, 175px"
                      data-zoom-sizes="(max-width: 40rem) 66vw, 420px"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                </li>
              ))}
            </ul>
          )}

          <div class="overlay">
            <p class="meta">{meta.map((part, k) => <><span class="part">{part}{k < meta.length - 1 && '\u00a0·'}</span>{k < meta.length - 1 && ' '}</>)}</p>
            <a class="strava" href={c.stravaUrls[0]} aria-label={`${c.title} on Strava`}><Icon name="strava" /></a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="moving full" aria-labelledby="moving">
    <h2 id="moving" class="section-title">We Keep Movin'</h2>
    <Calendar years={years} days={days} today={today} from={all.first ?? ''} milestones={milestones} yearNotes={yearNotes} labelledby="moving" />
    <p class="tooltip" role="status" hidden></p>
    <script type="application/json" id="calendar-days" set:html={JSON.stringify(tooltipDays)} />
  </section>

  <!-- Inline, so a card never waits on a download to appear. -->
  <script is:inline data-from={all.first} data-today={today}>
    (() => {
      const root = document.documentElement;
  
      // ---------- Cards play once, as they arrive ----------
      const play = (card) => {
        card.classList.add('play');
        for (const svg of card.querySelectorAll('svg.route')) {
          if (svg.getBoundingClientRect().width) svg.querySelector('animateMotion')?.beginElement();
        }
      };
      if (root.classList.contains('motion') && 'IntersectionObserver' in window) {
        const seen = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            play(entry.target);
            seen.unobserve(entry.target);
          }
        }, { threshold: 0.35 });
        document.querySelectorAll('.card').forEach((el) => seen.observe(el));
      } else {
        root.classList.remove('motion');
      }
  
      // ---------- A polaroid picked up, and put back ----------
      const putBack = (card) => {
        for (const slot of card.querySelectorAll('.slot.zoomed')) {
          slot.classList.remove('zoomed');
          slot.querySelector('.polaroid').setAttribute('aria-pressed', 'false');
          slot.classList.add('closing');
          clearTimeout(slot.landing);
          slot.landing = setTimeout(() => slot.classList.remove('closing'), 500);
        }
      };
      document.addEventListener('click', (event) => {
        const card = event.target.closest('.card');
        if (!card) return;
        const button = event.target.closest('.polaroid');
        if (!button) return putBack(card);
        const slot = button.parentElement;
        const wasUp = slot.classList.contains('zoomed');
        putBack(card);
        if (wasUp) return;
        // A photo still dropping in lands at once, to be picked up from where it lies.
        for (const animation of slot.getAnimations()) if (animation.animationName) animation.finish();
        clearTimeout(slot.landing);
        slot.classList.remove('closing');
        slot.classList.add('zoomed');
        button.setAttribute('aria-pressed', 'true');
      });
      // The sharper print is asked for as a hand reaches for a photo, so it is there once it is up.
      const sharpen = (event) => {
        const img = event.target.closest?.('.polaroid')?.querySelector('img');
        if (img?.dataset.zoomSizes && img.sizes !== img.dataset.zoomSizes) img.sizes = img.dataset.zoomSizes;
      };
      for (const type of ['pointerover', 'pointerdown', 'focusin']) document.addEventListener(type, sharpen);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') document.querySelectorAll('.card').forEach(putBack);
      });
  
      // ---------- The strip of days: it drifts on its own, and holds still for anyone looking ----------
      const script = document.currentScript;
      const from = script.dataset.from;
      const today = script.dataset.today;
      const days = JSON.parse(document.getElementById('calendar-days')?.textContent || '{}');
      const tip = document.querySelector('.moving .tooltip');
      const section = document.querySelector('.moving');
      const spoken = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
      const strip = document.querySelector('.strip');
      const track = strip?.querySelector('.track');
      const first = track?.querySelector('svg');
      let copy = null;
      let expected = 0;
      let restUntil = 0;
      let focused = false;
      let drag = null;
      let pointer = '';
      const now = () => performance.now();
      // Where the strip begins in its scroller, and how long it is: the copy begins at start + length.
      let start = 0;
      let length = 0;
      const measure = () => {
        start = parseFloat(getComputedStyle(track).paddingLeft) || 0;
        length = first.getBoundingClientRect().width;
      };
  
      if (strip && first && root.classList.contains('motion')) {
        // The same years again behind the first, so the strip comes round without a seam.
        copy = first.cloneNode(true);
        copy.setAttribute('aria-hidden', 'true');
        copy.removeAttribute('role');
        copy.removeAttribute('aria-label');
        track.append(copy);
        new ResizeObserver(measure).observe(first);
  
        const SPEED = 28; // px a second: slow enough to read a note as it passes
        let pos = 0;
        let last = 0;
        let frame = 0;
        const tick = (t) => {
          frame = requestAnimationFrame(tick);
          if (drag || focused || t < restUntil) {
            last = 0;
            track.style.transform = '';
            return;
          }
          // Carry on from wherever a hand left it.
          if (!last) pos = strip.scrollLeft;
          pos += (SPEED * Math.min(t - (last || t), 50)) / 1000;
          last = t;
          if (!length) measure();
          if (length && pos >= start + length) pos -= length;
          // Whole pixels by scrolling, and the fraction by a transform, so it glides at any speed.
          const whole = Math.floor(pos);
          strip.scrollLeft = expected = whole;
          track.style.transform = pos > whole ? `translateX(${(whole - pos).toFixed(2)}px)` : '';
          if (tip && !tip.hidden) tip.hidden = true;
        };
        new IntersectionObserver((entries) => {
          // Only the latest word counts: a quick fling past can bring "gone" and "back" together.
          cancelAnimationFrame(frame);
          last = 0;
          if (entries[entries.length - 1].isIntersecting) frame = requestAnimationFrame(tick);
        }).observe(strip);
  
        // A scroll it didn't make is someone's hand: a swipe, a wheel, a key. It waits for them.
        strip.addEventListener('scroll', () => {
          if (Math.abs(strip.scrollLeft - expected) > 1.5) restUntil = Math.max(restUntil, now() + 2500);
        }, { passive: true });
        // Reached by keyboard, it holds still to be read; a click to drag it doesn't hold it for good.
        strip.addEventListener('focusin', () => strip.matches(':focus-visible') && (focused = true));
        strip.addEventListener('focusout', () => (focused = false));
      }
  
      // A mouse looking at the strip holds it; a mouse leaving lets it go. Fingers scroll it natively.
      strip?.addEventListener('pointermove', (event) => {
        // Only a pointer that really moved: a strip drifting under a still one isn't someone looking.
        const at = `${event.clientX},${event.clientY}`;
        if (event.pointerType !== 'touch' && at !== pointer) restUntil = now() + 3000;
        pointer = at;
        if (!drag || event.pointerId !== drag.id) return;
        // The button came up somewhere we never heard about: the drag is over.
        if (!(event.buttons & 1)) return letGo(event);
        const dx = event.clientX - drag.x;
        if (!strip.classList.contains('dragging')) {
          if (Math.abs(dx) < 4) return;
          strip.classList.add('dragging');
          if (tip) tip.hidden = true;
        }
        let left = drag.left - dx;
        if (copy) {
          // Dragged past either end, it comes round, as it does on its own.
          if (left < start) (left += length), (drag.left += length);
          else if (left >= start + length) (left -= length), (drag.left -= length);
        }
        strip.scrollLeft = expected = left;
      });
      strip?.addEventListener('pointerdown', (event) => {
        restUntil = now() + (event.pointerType === 'touch' ? 4000 : 3000);
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        drag = { id: event.pointerId, x: event.clientX, left: strip.scrollLeft };
        // Held from the press, so the release reaches the strip wherever the mouse has wandered.
        strip.setPointerCapture(event.pointerId);
      });
      function letGo(event) {
        if (event.pointerType === 'touch') restUntil = now() + 3000;
        if (!drag || event.pointerId !== drag.id) return;
        drag = null;
        strip.classList.remove('dragging');
      }
      strip?.addEventListener('pointerup', letGo);
      strip?.addEventListener('pointercancel', letGo);
      strip?.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'touch' && !drag) restUntil = 0;
      });
  
      // ---------- What happened on a day in the strip ----------
  
      // The day under a point. The gaps between squares belong to the nearest day, so the tooltip
      // doesn't blink on and off as a pointer crosses them.
      const dateAt = (svg, clientX, clientY) => {
        const point = new DOMPoint(clientX, clientY).matrixTransform(svg.getScreenCTM().inverse());
        const top = Number(svg.dataset.top);
        const step = Number(svg.dataset.step);
        const half = (step - Number(svg.dataset.cell)) / 2;
        const row = Math.floor((point.y - top + half) / step);
        if (row < 0 || row > 6) return null;
        for (const [year, left, offset, skip, columns] of JSON.parse(svg.dataset.years)) {
          const col = Math.floor((point.x - left + half) / step);
          if (col < skip || col >= columns) continue;
          const date = new Date(Date.UTC(year, 0, 1 + col * 7 + row - offset));
          const iso = date.toISOString().slice(0, 10);
          return date.getUTCFullYear() === year && iso >= svg.dataset.start && iso <= today ? iso : null;
        }
        return null;
      };
  
      let hideSoon = 0;
      const hide = () => tip && (tip.hidden = true);
      const show = (event) => {
        clearTimeout(hideSoon);
        const svg = event.target.closest?.('svg.days');
        const date = svg && !strip.classList.contains('dragging') && dateAt(svg, event.clientX, event.clientY);
        if (!tip || !date) return hide();
        const what = date < from ? 'before the journal began' : days[date] || 'rest day';
        tip.textContent = `${spoken.format(new Date(`${date}T00:00:00Z`)).replace(',', '')} · ${what}`;
        tip.hidden = false;
        const box = section.getBoundingClientRect();
        const x = Math.min(Math.max(event.clientX - box.left - tip.offsetWidth / 2, 8), box.width - tip.offsetWidth - 8);
        tip.style.transform = `translate(${x}px, ${event.clientY - box.top - 46}px)`;
      };
      section?.addEventListener('pointermove', show);
      section?.addEventListener('pointerdown', show);
      // A finger lifts as soon as it taps, so what it tapped stays up a moment longer.
      section?.addEventListener('pointerleave', (event) => {
        clearTimeout(hideSoon);
        if (event.pointerType === 'touch') hideSoon = setTimeout(hide, 2500);
        else hide();
      });
    })();
  </script>
</BaseLayout>



<style>
  /* ---------- Page ---------- */

  /* The sketches sit behind everything on the page, clipped to it so none can widen a phone. */
  :global(main:has(.sketches)) {
    position: relative;
    isolation: isolate;
  }

  .sketches {
    grid-column: 1 / -1;
    grid-row: auto;
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
  }

  .sketch {
    position: absolute;
    width: clamp(180px, 16vw, 320px);
    height: auto;
    opacity: 0.18;
    mix-blend-mode: multiply;
    transform: rotate(var(--tilt));
  }

  .sketch.left {
    left: var(--nudge);
  }

  .sketch.right {
    right: var(--nudge);
  }

  @media (prefers-color-scheme: dark) {
    .sketch {
      filter: invert(1);
      mix-blend-mode: screen;
      opacity: 0.1;
    }
  }

  @media (max-width: 69rem) {
    .sketch {
      width: clamp(120px, 20vw, 180px);
      opacity: 0.14;
    }
  }

  @media (max-width: 40rem) {
    .sketch {
      width: 110px;
      opacity: 0.12;
    }

    .sketch.left {
      left: -15px;
    }

    .sketch.right {
      right: -15px;
    }
  }

  .title {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .section-title {
