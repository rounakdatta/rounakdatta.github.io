  /* A size container, so a photo can measure its way to the middle of the map in cqw and cqh. */
  .polaroids {
    position: absolute;
    inset: 0;
    z-index: 10;
    margin: 0;
    padding: 0;
    list-style: none;
    container-type: size;
  }

  /* A photo moves by transform alone, so picking it up and putting it back stay smooth. */
  .slot {
    --px: var(--x);
    --py: var(--y);
    position: absolute;
    left: calc(var(--px) * 100%);
    top: calc(var(--py) * 100%);
    z-index: calc(1 + var(--i));
    width: 23%;
    translate: -50% -50%;
    rotate: var(--r);
    transition:
      translate 0.45s var(--ease-out),
