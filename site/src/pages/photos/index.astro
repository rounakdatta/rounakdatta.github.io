---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoLink from '../../components/PhotoLink.astro';
import PhotoViewer from '../../components/PhotoViewer.astro';
import Icon from '../../components/Icon.astro';
import { printScale, altOf } from '../../lib/photos';

const albums = (await getCollection('photoAlbums')).sort((a, b) => a.data.order - b.data.order);
// The tallest print, on a phone and on anything larger; the rest hang smaller.
const TALLEST = { phone: 280, larger: 400 };
---

<BaseLayout title="Photos" description="Photographs by Rounak Datta: trips, weddings, mountains and cities.">
  <header class="head">
    <h1>Photos</h1>
    <p class="lede">WDYM one needs Instagram to have a colourful life?</p>
  </header>

  {albums.map((album, a) => (
    <section class="album" aria-labelledby={`album-${album.id}`}>
      <header class="album-head">
        <h2 id={`album-${album.id}`}><a href={`/photos/${album.id}/`}>{album.data.title}</a></h2>
        {album.data.subtitle && <p class="album-meta"><span class="subtitle">{album.data.subtitle}</span></p>}
      </header>
      <div class="wall full">
        <ul class="prints" data-gallery tabindex="0" aria-label={`${album.data.title}, scroll for more`}>
          {album.data.photos.map((photo, i) => {
            const scale = printScale(photo.src.width / photo.src.height, i);
            return (
              <li style={`--scale: ${scale.toFixed(3)}`}>
                <PhotoLink photo={photo} heights={[Math.round(TALLEST.phone * scale), Math.round(TALLEST.larger * scale)]} priority={a === 0 && i < 2} />
                {/* Read once: when the photo has no alt text of its own, the caption already stands in for it. */}
                {photo.caption && <p class="caption" aria-hidden={altOf(photo) === photo.caption ? 'true' : undefined}>{photo.caption}</p>}
              </li>
            );
          })}
        </ul>
        <button type="button" class="nudge back" aria-label="Earlier photos" hidden><Icon name="arrow-left" /></button>
        <button type="button" class="nudge on" aria-label="Later photos" hidden><Icon name="arrow-right" /></button>
      </div>
    </section>
  ))}

  <PhotoViewer />
</BaseLayout>

<script>
  // A mouse can't easily scroll sideways, so it gets a way along: an arrow at each end of the
  // strip, shown on hover, and only where there is more to see.
  for (const wall of document.querySelectorAll<HTMLElement>('.wall')) {
    const prints = wall.querySelector<HTMLElement>('.prints')!;
    const [back, on] = wall.querySelectorAll<HTMLButtonElement>('.nudge');
    const update = () => {
      back.hidden = prints.scrollLeft < 8;
      on.hidden = prints.scrollLeft + prints.clientWidth > prints.scrollWidth - 8;
    };
    const go = (direction: number) =>
      prints.scrollBy({
        left: direction * prints.clientWidth * 0.7,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    back.addEventListener('click', () => go(-1));
    on.addEventListener('click', () => go(1));
    prints.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(prints);
  }
</script>

<style>
  .lede {
    color: var(--ink-muted);
    font-style: italic;
  }

  /* Sections hold a full-width strip, so they are grids that pass the page's columns through. */
  .album {
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: 2.5em;
  }

  .album > * {
    grid-column: content;
  }

  .album > .full {
    grid-column: full;
  }

  .album-head h2 {
    margin: 0;
    font-size: 1.3em;
  }

  .album-head h2 a {
    text-decoration: none;
  }

  .album-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.8em;
    margin: 0.1em 0 1.4em;
    color: var(--ink-muted);
    font-size: 0.92em;
  }

  .subtitle {
    font-style: italic;
  }

  /* ---------- The prints ---------- */

  .wall {
    --tallest: 400px;
    position: relative;
  }

  /* Hung along one line, each print its own shape and its own size, the strip fading in and out
     at the edges of the screen as the maps do. It starts in line with the text. */
  .prints {
    --inset: max(var(--gutter), (100% - var(--measure)) / 2);
    --fade: min(6vw, 5rem);
    display: flex;
    align-items: flex-end;
    gap: clamp(1.1rem, 2.6vw, 2.2rem);
    margin: 0;
    /* Room above for a print to lift, and below the line for the captions. */
    padding: 0.5rem var(--inset) 3.4em;
    scroll-padding-inline: var(--inset);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
  }

  .prints::-webkit-scrollbar {
    display: none;
  }

  .prints li {
    position: relative;
    flex: none;
    scroll-snap-align: start;
  }

  .prints :global(.photo-link) {
    display: block;
    height: calc(var(--tallest) * var(--scale));
    aspect-ratio: var(--aspect);
    border-radius: 2px;
    overflow: hidden;
    background: var(--paper-raised);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 14px 28px -18px rgb(0 0 0 / 0.5);
    transition:
      translate 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  /* A print under the pointer lifts a little off the wall. */
  .prints :global(.photo-link:hover),
  .prints :global(.photo-link:focus-visible) {
    translate: 0 -4px;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.08), 0 22px 36px -20px rgb(0 0 0 / 0.55);
  }

  .prints :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The caption hangs under its print, as narrow as the print, so every print keeps the one line. */
  .caption {
    position: absolute;
    inset: 100% 0 auto;
    margin: 0.75em 0 0;
    font-size: 0.82em;
    font-style: italic;
    line-height: 1.3;
    color: var(--ink-muted);
    text-wrap: balance;
  }

  .prints:focus-visible {
    outline: none;
  }

  .wall:has(.prints:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* ---------- A way along for a mouse ---------- */

  .nudge {
    position: absolute;
    top: calc(0.5rem + var(--tallest) / 2);
    translate: 0 -50%;
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(8px);
    color: var(--ink);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.1);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .back {
    left: max(1rem, 2.5vw);
  }

  .on {
    right: max(1rem, 2.5vw);
  }

  @media (hover: hover) and (pointer: fine) {
    .nudge:not([hidden]) {
      display: grid;
    }

    .wall:hover .nudge,
    .nudge:focus-visible {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prints :global(.photo-link) {
      transition: none;
    }
  }

  @media (max-width: 34rem) {
    .wall {
      --tallest: 280px;
    }

    .prints {
      --fade: 12px;
    }
  }
</style>
