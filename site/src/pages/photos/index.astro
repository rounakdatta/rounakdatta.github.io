---
import { getCollection } from 'astro:content';
import sharp from 'sharp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoLink from '../../components/PhotoLink.astro';
import PhotoViewer from '../../components/PhotoViewer.astro';
import Icon from '../../components/Icon.astro';
import { altOf, type Photo } from '../../lib/photos';

const albums = (await getCollection('photoAlbums')).sort((a, b) => a.data.order - b.data.order);

// Every photo hangs in the same frame, square on a wide screen and 4:5 on a phone, shown whole
// and melting into the page at its edges, as the fitness maps do, over a faint bloom of its own
// colours.
const CARD = 600;
const PHONE = { vw: 82, aspect: 4 / 5 };

/** The photo's colours as a wash: a tiny, softened, richer copy, scaled up wherever it is shown. */
async function glowOf(photo: Photo) {
  const file = (photo.src as unknown as { fsPath?: string }).fsPath;
  if (!file) return '';
  const tiny = await sharp(file).rotate().resize(10, 10, { fit: 'cover' }).blur(1.2).modulate({ saturation: 1.55 }).webp({ quality: 80 }).toBuffer();
  return `data:image/webp;base64,${tiny.toString('base64')}`;
}

/** How wide a photo is drawn once fitted whole into its frame, for the browser to pick a size. */
const sizesOf = (photo: Photo) => {
  const aspect = photo.src.width / photo.src.height;
  const wide = Math.min(1, aspect);
  // The frame is 42vw wide until it reaches 600px (at about 1430px across), as the CSS has it.
  return `(max-width: 40rem) ${Math.round(PHONE.vw * Math.min(1, aspect / PHONE.aspect))}vw, (max-width: 1430px) ${Math.round(42 * wide)}vw, ${Math.round(CARD * wide)}px`;
};

const shown = await Promise.all(
  albums.map(async (album) => ({ album, photos: await Promise.all(album.data.photos.map(async (photo) => ({ photo, glow: await glowOf(photo) }))) })),
);
---

<BaseLayout title="Photos" description="Photographs by Rounak Datta: trips, weddings, mountains and cities.">
  <header class="head">
    <h1>Photos</h1>
    <p class="lede">WDYM one needs Instagram to have a colourful life?</p>
  </header>

  {shown.map(({ album, photos }, a) => (
    <section class="album" aria-labelledby={`album-${album.id}`}>
      <h2 id={`album-${album.id}`}>{album.data.title}</h2>
      <div class="gallery full">
        <div class="strip" tabindex="0" role="group" aria-labelledby={`album-${album.id}`}>
          <div class="track">
            <ul data-gallery>
              {photos.map(({ photo, glow }, i) => (
                <li class="frame" style={`--a: ${(photo.src.width / photo.src.height).toFixed(4)};${glow ? ` --glow: url("${glow}")` : ''}`}>
                  <PhotoLink photo={photo} sizes={sizesOf(photo)} priority={a === 0 && i < 2} />
                  {/* Read once: with no alt text of its own, the photo already says its caption. */}
                  {photo.caption && <p class="caption" aria-hidden={altOf(photo) === photo.caption ? 'true' : undefined}>{photo.caption}</p>}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <button type="button" class="nudge back" aria-label="Earlier photos" hidden><Icon name="arrow-left" /></button>
        <button type="button" class="nudge on" aria-label="Later photos" hidden><Icon name="arrow-right" /></button>
      </div>
    </section>
  ))}

  <PhotoViewer />
</BaseLayout>

<script>
  import { drift } from '../../scripts/drift';

  for (const gallery of document.querySelectorAll<HTMLElement>('.gallery')) {
    const strip = gallery.querySelector<HTMLElement>('.strip')!;
    const [back, on] = gallery.querySelectorAll<HTMLButtonElement>('.nudge');
    // Slowly enough to look at each photo as it passes; never while one is open full-screen.
    const motion = drift(strip, { speed: 20, held: () => !!document.querySelector('.pswp') });

    // A mouse can't easily scroll sideways, so it gets an arrow at each end, a photo at a time.
    // Drifting, the strip comes round, so there is always somewhere to go either way.
    const step = () => {
      const frames = strip.querySelectorAll<HTMLElement>('.frame');
      return frames.length > 1 ? frames[1].offsetLeft - frames[0].offsetLeft : strip.clientWidth * 0.7;
    };
    const update = () => {
      back.hidden = !motion.moving && strip.scrollLeft < 8;
      on.hidden = !motion.moving && strip.scrollLeft + strip.clientWidth > strip.scrollWidth - 8;
    };
    const go = (direction: number) => {
      motion.hold(4000);
      const { start, length } = motion.span();
      if (motion.moving && length) {
        if (direction < 0 && strip.scrollLeft - step() < start) strip.scrollLeft += length;
        // Only from where the copy shows exactly what the original does, so nothing blinks.
        if (direction > 0 && strip.scrollLeft >= start + length) strip.scrollLeft -= length;
      }
      strip.scrollBy({ left: direction * step(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    back.addEventListener('click', () => go(-1));
    on.addEventListener('click', () => go(1));
    strip.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(strip);
  }
</script>

<style>
  .lede {
    color: var(--ink-muted);
    font-style: italic;
  }

  /* Sections hold a full-width gallery, so they are grids that pass the page's columns through. */
  .album {
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: 1.9em;
  }

  .album > * {
    grid-column: content;
  }

  .album > .full {
    grid-column: full;
  }

  .album h2 {
    margin: 0;
    font-size: 1.3em;
  }

  /* ---------- The gallery ---------- */

  .gallery {
    /* As big as the screen allows: never wider than 600px, never taller than most of the window. */
    --card: clamp(300px, min(42vw, 70vh), 600px);
    --card-aspect: 1;
    --card-h: var(--card);
    --gap: clamp(1.75rem, 3.6vw, 3.25rem);
    --fade: min(6vw, 5rem);
    --lift: 4.5rem;
    position: relative;
    container-type: inline-size;
  }

  /* The strip fades in and out at the edges of the screen, as the maps do. */
  .strip {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .strip:focus-visible {
    outline: none;
  }

  .gallery:has(.strip:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* It starts in line with the text; room above and below for the glow. */
  .track {
    display: flex;
    gap: var(--gap);
    width: max-content;
    padding: var(--lift) max(var(--gutter), (100cqw - var(--measure)) / 2) 2.4rem;
  }

  .track ul {
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frame {
    position: relative;
    isolation: isolate;
    flex: none;
    width: var(--card);
  }

  /* A faint bloom of the photo's own colours behind it, kept inside the strip so nothing cuts it. */
  .frame::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6% -10% 8%;
    background: var(--glow) center / cover;
    opacity: 0.4;
    mask-image: radial-gradient(closest-side, #000 20%, transparent);
  }

  /* The frame: one size for every photo. A size container, so the photo knows its final size
     before a byte of it arrives and nothing jumps as it loads. */
  .frame :global(.photo-link) {
    container-type: size;
    display: grid;
    place-items: center;
    aspect-ratio: var(--card-aspect);
  }

  /* Whole and as large as the frame allows, its edges melting into the page as the maps' do, a
     little more at the foot, where the caption sits on bare paper. */
  .frame :global(img) {
    display: block;
    width: min(100cqw, 100cqh * var(--a));
    height: auto;
    aspect-ratio: var(--a);
    mask-image:
      linear-gradient(to right, transparent, #000 13%, #000 87%, transparent),
      linear-gradient(to bottom, transparent, #000 11%, #000 84%, transparent);
    mask-composite: intersect;
  }

  .caption {
    margin: 1.05rem 0 0;
    font-size: 0.95em;
    font-style: italic;
    text-align: center;
    color: var(--ink-muted);
    text-wrap: balance;
  }

  /* ---------- A way along for a mouse ---------- */

  .nudge {
    position: absolute;
    top: calc(var(--lift) + var(--card-h) / 2);
    translate: 0 -50%;
    display: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: color-mix(in oklab, var(--paper) 84%, transparent);
    backdrop-filter: blur(8px);
    color: var(--ink);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .back {
    left: max(1rem, 2.5vw);
  }

  .on {
    right: max(1rem, 2.5vw);
  }

  @media (hover: hover) and (pointer: fine) {
    .nudge:not([hidden]) {
      display: grid;
    }

    .gallery:hover .nudge,
    .nudge:focus-visible {
      opacity: 1;
    }
  }

  @media (prefers-color-scheme: dark) {
    .frame::before {
      opacity: 0.32;
    }
  }

  /* A phone gets one tall frame at a time, the next one coming in at the edge. */
  @media (max-width: 40rem) {
    /* As wide as a phone allows, and never taller than it either: on its side, a frame still fits. */
    .gallery {
      --card: min(82vw, 64svh);
      --card-aspect: 4 / 5;
      --card-h: calc(var(--card) * 5 / 4);
      --gap: 1.1rem;
      --fade: 10px;
      --lift: 3rem;
    }

    .frame :global(img) {
      mask-image:
        linear-gradient(to right, transparent, #000 9%, #000 91%, transparent),
        linear-gradient(to bottom, transparent, #000 8%, #000 86%, transparent);
    }
  }
</style>
