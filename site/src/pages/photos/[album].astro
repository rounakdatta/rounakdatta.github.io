---
// An album once had a page of its own. Every album now hangs on /photos/, so its old address
// leads to it there rather than to nothing.
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('photoAlbums')).map((album) => ({ params: { album: album.id } }));
}

const target = `/photos/#album-${Astro.params.album}`;
---

<html lang="en">
  <head>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Photos</title>
  </head>
  <body>
    <p>This album is now on <a href={target}>the photos page</a>.</p>
  </body>
</html>
